# Copiar a backend/.env y completar. NUNCA commitear el .env real.

# Base de datos. En producción, Supabase Session Pooler (puerto 6543):
# la URL directa falla porque Railway sale por IPv4 y el host directo es IPv6.
DATABASE_URL=sqlite+aiosqlite:///./local.db

JWT_SECRET_KEY=cambiar-en-produccion
JWT_EXPIRE_HOURS=12

ENVIRONMENT=development

# Contraseña de las cuentas del seed inicial. Definirla en Railway.
SEED_PASSWORD=anorak1234

# Fondo que queda en el cajón al cerrar, para dar vuelto al día siguiente.
FONDO_FIJO_SUGERIDO=20000.00

# Facturación electrónica: apagada hasta tener los certificados.
ARCA_HABILITADO=false
ARCA_CUIT=
ARCA_PUNTO_VENTA=1

# Cloudflare R2 (imágenes)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=anorak-imagenes

FRONTEND_URL=http://localhost:5173
